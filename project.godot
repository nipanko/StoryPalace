; Engine configuration file.

config_version=5

[application]

config/name="Memory Palace"
config/description="Build memory palaces and remember anything."
config/version="1.0.0"
run/main_scene="res://main.tscn"
run/low_processor_mode=true
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="Memory Palace"
config/windows_native_icon="res://build_assets/icon.ico"
boot_splash/bg_color=Color(0.169, 0.227, 0.561, 1)
boot_splash/show_image=false

[autoload]

Store="*res://scripts/store.gd"

[display]

window/size/viewport_width=1360
window/size/viewport_height=860
window/size/min_width=1024
window/size/min_height=680
window/energy_saving/keep_screen_on=false

[gui]

common/snap_controls_to_pixels=true
timers/tooltip_delay_sec=0.4

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.957, 0.961, 0.984, 1)
